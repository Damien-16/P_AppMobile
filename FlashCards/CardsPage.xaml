<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlashCards.CardsPage"
             Title="Créer Cartes"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">

        <!-- Add Card Form -->
        <StackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,12">

            <!-- Recto Entry -->
            <Label Text="Recto (Question)"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextSecondary}"
                   Margin="4,0,0,2" />
            <Frame BackgroundColor="{StaticResource CardBackground}"
                   BorderColor="{StaticResource Gray200}"
                   CornerRadius="12"
                   Padding="12,4"
                   HasShadow="False">
                <Entry x:Name="FrontEntry"
                       Placeholder="Écrivez ici"
                       PlaceholderColor="{StaticResource TextMuted}"
                       TextColor="{StaticResource TextPrimary}"
                       BackgroundColor="Transparent"
                       MaxLength="255" />
            </Frame>

            <!-- Verso Entry -->
            <Label Text="Verso (Réponse)"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextSecondary}"
                   Margin="4,8,0,2" />
            <Frame BackgroundColor="{StaticResource CardBackground}"
                   BorderColor="{StaticResource Gray200}"
                   CornerRadius="12"
                   Padding="12,4"
                   HasShadow="False">
                <Entry x:Name="BackEntry"
                       Placeholder="Écrivez ici"
                       PlaceholderColor="{StaticResource TextMuted}"
                       TextColor="{StaticResource TextPrimary}"
                       BackgroundColor="Transparent"
                       MaxLength="255" />
            </Frame>

            <!-- Save Button -->
            <Button Text="Enregistrer"
                    Clicked="OnAddCardClicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="52"
                    FontSize="16"
                    FontAttributes="Bold"
                    Margin="0,8,0,0" />

        </StackLayout>

        <!-- Cards List -->
        <CollectionView Grid.Row="1" x:Name="CardsCollectionView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5"
                           Padding="14,12"
                           BackgroundColor="{StaticResource CardBackground}"
                           BorderColor="{StaticResource Gray200}"
                           CornerRadius="12"
                           HasShadow="False">
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="{Binding Front}"
                                   VerticalOptions="Center"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Grid.Column="1"
                                   Text="{Binding Back}"
                                   VerticalOptions="Center"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Button Grid.Column="2"
                                    Text="🗑️"
                                    Clicked="OnDeleteCardClicked"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource AccentRed}"
                                    Padding="4"
                                    HeightRequest="40"
                                    WidthRequest="44" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom Button -->
        <Button Grid.Row="2"
                Text="Retour"
                Clicked="OnBackClicked"
                BackgroundColor="Transparent"
                TextColor="{StaticResource TextSecondary}"
                BorderColor="{StaticResource Gray200}"
                BorderWidth="1"
                CornerRadius="12"
                HeightRequest="50"
                Margin="0,10,0,0" />
    </Grid>

</ContentPage>