<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlashCards.EditDeckPage"
             Title="Modifier le deck"
             BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <StackLayout Padding="20" Spacing="16">

            <!-- Deck Name -->
            <Label Text="Nom du deck"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextSecondary}"
                   Margin="4,0,0,4" />

            <Frame BackgroundColor="{StaticResource CardBackground}"
                   BorderColor="{StaticResource Gray200}"
                   CornerRadius="12"
                   Padding="12,4"
                   HasShadow="False">
                <Entry x:Name="NameEntry"
                       Placeholder="Nom du deck"
                       PlaceholderColor="{StaticResource TextMuted}"
                       TextColor="{StaticResource TextPrimary}"
                       BackgroundColor="Transparent"
                       FontSize="16" />
            </Frame>

            <!-- Card Count -->
            <Label Text="Nombre de cartes"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextSecondary}"
                   Margin="4,12,0,4" />

            <Frame BackgroundColor="{StaticResource CardBackground}"
                   BorderColor="{StaticResource Gray200}"
                   CornerRadius="12"
                   Padding="16,12"
                   HasShadow="False">
                <Label x:Name="CardCountLabel"
                       Text="0"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </Frame>

            <!-- Save Button -->
            <Button Text="Sauvegarder"
                    Clicked="OnSaveClicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="14"
                    HeightRequest="54"
                    FontSize="16"
                    FontAttributes="Bold"
                    Margin="0,24,0,0" />

            <!-- Cancel Button -->
            <Button Text="Annuler"
                    Clicked="OnCancelClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource TextSecondary}"
                    BorderColor="{StaticResource Gray200}"
                    BorderWidth="1"
                    CornerRadius="14"
                    HeightRequest="54"
                    FontSize="16" />

        </StackLayout>
    </ScrollView>

</ContentPage>