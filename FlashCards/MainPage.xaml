<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlashCards.MainPage"
             BackgroundColor="{StaticResource PageBackground}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- Header Bar -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource CardBackground}"
              Padding="20,16"
              ColumnDefinitions="Auto,*">
            <Label Grid.Column="0"
                   Text="☰"
                   FontSize="22"
                   TextColor="{StaticResource TextPrimary}"
                   VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenuClicked" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1"
                   Text="Ozzlet"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Main Content -->
        <VerticalStackLayout Grid.Row="1"
                             Padding="30,0"
                             Spacing="20"
                             VerticalOptions="Center">

            <Label Text="Bienvenu sur&#10;Ozzlet"
                   TextColor="{StaticResource Primary}"
                   FontSize="30"
                   FontFamily="OpenSansSemibold"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,30" />

            <Button Text="Apprendre"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    HeightRequest="56"
                    CornerRadius="14"
                    FontSize="17"
                    FontAttributes="Bold"
                    Clicked="OnLearnClicked" />

            <Button Text="Gérer mes cartes"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    BorderColor="{StaticResource Primary}"
                    BorderWidth="1.5"
                    HeightRequest="56"
                    CornerRadius="14"
                    FontSize="17"
                    Clicked="OnManageDecksClicked" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>