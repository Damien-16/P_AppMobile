<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlashCards.StudyPage"
             Title="Apprentissage"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid Padding="16" RowDefinitions="Auto,*,Auto,Auto">

        <!-- Progress Bar Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12"
              Margin="0,0,0,16">
            <Label Grid.Column="0"
                   Text="Quitter"
                   FontSize="14"
                   TextColor="{StaticResource TextSecondary}"
                   VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackToDecksClicked" />
                </Label.GestureRecognizers>
            </Label>
            <ProgressBar Grid.Column="1"
                         x:Name="StudyProgressBar"
                         Progress="0"
                         ProgressColor="{StaticResource Primary}"
                         VerticalOptions="Center" />
            <Label Grid.Column="2"
                   x:Name="ProgressLabel"
                   FontSize="14"
                   TextColor="{StaticResource TextSecondary}"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Flashcard -->
        <Frame Grid.Row="1"
               x:Name="CardFrame"
               VerticalOptions="Fill"
               HorizontalOptions="Fill"
               CornerRadius="20"
               BackgroundColor="{StaticResource CardBackground}"
               BorderColor="{StaticResource Gray200}"
               HasShadow="False">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFlipClicked" />
            </Frame.GestureRecognizers>
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <Label x:Name="SideLabel"
                       Text="Recto"
                       FontSize="12"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalOptions="Center" />
                <Label x:Name="CardTextLabel"
                       Text="Question"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center" />
                <Label Text="Appuyez pour retourner"
                       FontSize="12"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalOptions="Center"
                       Margin="0,20,0,0" />
            </VerticalStackLayout>
        </Frame>

        <!-- Timer Row -->
        <Label Grid.Row="2"
               x:Name="TimerLabel"
               Text="00:00"
               HorizontalOptions="End"
               TextColor="{StaticResource TextMuted}"
               FontSize="13"
               Margin="0,10,4,0" />

        <!-- Action Buttons -->
        <Grid Grid.Row="3"
              x:Name="StudyControls"
              ColumnDefinitions="*,*"
              ColumnSpacing="12"
              Margin="0,8,0,0">
            <Button Grid.Column="0"
                    Text="Faux"
                    Clicked="OnIncorrectClicked"
                    BackgroundColor="{StaticResource AccentRed}"
                    TextColor="White"
                    CornerRadius="14"
                    HeightRequest="54"
                    FontSize="16"
                    FontAttributes="Bold" />
            <Button Grid.Column="1"
                    Text="Valider"
                    Clicked="OnCorrectClicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="14"
                    HeightRequest="54"
                    FontSize="16"
                    FontAttributes="Bold" />
        </Grid>

        <!-- Stats View (Session Terminée) -->
        <Grid Grid.Row="0" Grid.RowSpan="4"
              x:Name="StatsView"
              IsVisible="False"
              BackgroundColor="{StaticResource Primary}"
              RowDefinitions="*,Auto">

            <VerticalStackLayout Grid.Row="0"
                                 VerticalOptions="Center"
                                 Spacing="24"
                                 Padding="20">

                <!-- Icon and Title -->
                <Label Text="📊"
                       FontSize="56"
                       HorizontalOptions="Center"
                       TextColor="White" />
                <Label Text="Session Terminée"
                       FontSize="26"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="White" />

                <!-- Stats Cards Row -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Frame Grid.Column="0"
                           BackgroundColor="#5D6AE8"
                           BorderColor="Transparent"
                           CornerRadius="16"
                           Padding="14">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="⏱️" FontSize="22" HorizontalOptions="Center" />
                            <Label x:Name="TimeLabel"
                                   Text="1 m 55s"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center" />
                            <Label Text="Temps passé"
                                   FontSize="11"
                                   TextColor="#C5CCFF"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="1"
                           BackgroundColor="#5D6AE8"
                           BorderColor="Transparent"
                           CornerRadius="16"
                           Padding="14">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="✅" FontSize="22" HorizontalOptions="Center" />
                            <Label x:Name="PercentageLabel"
                                   Text="33%"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center" />
                            <Label Text="Correcte"
                                   FontSize="11"
                                   TextColor="#C5CCFF"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Hardest Card -->
                <Frame BackgroundColor="#5D6AE8"
                       BorderColor="Transparent"
                       CornerRadius="16"
                       Padding="14"
                       WidthRequest="200"
                       HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="❌" FontSize="22" HorizontalOptions="Center" />
                        <Label x:Name="HardestCardLabel"
                               Text="Card"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" />
                        <Label Text="Le plus dure"
                               FontSize="11"
                               TextColor="#C5CCFF"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- Bottom Action Buttons -->
            <Frame Grid.Row="1"
                   BackgroundColor="{StaticResource CardBackground}"
                   Padding="20,24"
                   Margin="0"
                   HasShadow="False"
                   BorderColor="Transparent"
                   CornerRadius="0">
                <VerticalStackLayout Spacing="12">
                    <Button Text="🔄 Recommencer"
                            Clicked="OnRestartClicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            HeightRequest="56"
                            CornerRadius="14"
                            FontSize="17"
                            FontAttributes="Bold" />
                    <Button Text="Retour au menu"
                            Clicked="OnBackToDecksClicked"
                            BackgroundColor="{StaticResource Gray100}"
                            TextColor="{StaticResource TextPrimary}"
                            HeightRequest="56"
                            CornerRadius="14"
                            FontSize="17" />
                </VerticalStackLayout>
            </Frame>
        </Grid>

    </Grid>

</ContentPage>