<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FlashCards"
             x:Class="FlashCards.DecksPage"
             Title="Mes Decks"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16">

        <!-- Add Deck Row -->
        <Frame Grid.Row="0"
               x:Name="AddDeckFrame"
               BackgroundColor="{StaticResource CardBackground}"
               BorderColor="{StaticResource Gray200}"
               CornerRadius="14"
               Padding="12,8"
               Margin="0,0,0,12"
               HasShadow="False">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Entry Grid.Column="0"
                       x:Name="NewDeckEntry"
                       Placeholder="Nom du nouveau deck"
                       PlaceholderColor="{StaticResource TextMuted}"
                       TextColor="{StaticResource TextPrimary}"
                       BackgroundColor="Transparent" />
                <Button Grid.Column="1"
                        Text="Ajouter"
                        Clicked="OnAddDeckClicked"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="10"
                        Padding="16,10"
                        FontAttributes="Bold"
                        HeightRequest="44" />
            </Grid>
        </Frame>

        <!-- Search Entry -->
        <Frame Grid.Row="1"
               BackgroundColor="{StaticResource CardBackground}"
               BorderColor="{StaticResource Gray200}"
               CornerRadius="14"
               Padding="12,4"
               Margin="0,0,0,12"
               HasShadow="False">
            <Entry x:Name="SearchEntry"
                   Placeholder="Rechercher un deck..."
                   PlaceholderColor="{StaticResource TextMuted}"
                   TextColor="{StaticResource TextPrimary}"
                   BackgroundColor="Transparent"
                   TextChanged="OnSearchTextChanged" />
        </Frame>

        <!-- Decks List -->
        <CollectionView Grid.Row="2"
                        x:Name="DecksCollectionView"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5"
                           Padding="14,12"
                           BackgroundColor="{StaticResource CardBackground}"
                           BorderColor="{StaticResource Gray200}"
                           CornerRadius="14"
                           HasShadow="False">

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDeckTapped" />
                        </Frame.GestureRecognizers>

                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                            <StackLayout Grid.Column="0"
                                         VerticalOptions="Center"
                                         Spacing="2">
                                <Label Text="{Binding Name}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding CardCount, StringFormat='{0} cartes'}"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding CreatedDate, StringFormat='Créé le {0:dd/MM/yyyy}'}"
                                       FontSize="11"
                                       TextColor="{StaticResource TextMuted}" />
                            </StackLayout>

                            <Button Grid.Column="1"
                                    Text="🎓"
                                    FontSize="18"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource Primary}"
                                    Clicked="OnStudyDeckClicked"
                                    CommandParameter="{Binding .}"
                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type local:DecksPage}}, Path=IsManageMode}"
                                    Padding="6"
                                    HeightRequest="40"
                                    WidthRequest="44" />

                            <Button Grid.Column="2"
                                    Text="✏️"
                                    FontSize="18"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource TextSecondary}"
                                    Clicked="OnEditDeckClicked"
                                    CommandParameter="{Binding .}"
                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type local:DecksPage}}, Path=IsManageMode}"
                                    Padding="6"
                                    HeightRequest="40"
                                    WidthRequest="44" />

                            <Button Grid.Column="3"
                                    Text="🗑️"
                                    FontSize="18"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource AccentRed}"
                                    Clicked="OnDeleteDeckClicked"
                                    CommandParameter="{Binding .}"
                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type local:DecksPage}}, Path=IsManageMode}"
                                    Padding="6"
                                    HeightRequest="40"
                                    WidthRequest="44" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <StackLayout HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="10"
                             Padding="0,40">
                    <Label Text="📚"
                           FontSize="60"
                           HorizontalOptions="Center" />
                    <Label Text="Aucun deck"
                           FontSize="18"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalOptions="Center" />
                    <Label Text="Créez votre premier deck ci-dessus"
                           FontSize="13"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalOptions="Center" />
                </StackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Status Label -->
        <Label Grid.Row="3"
               x:Name="InfoLabel"
               Text="Prêt"
               FontSize="12"
               TextColor="{StaticResource TextMuted}"
               HorizontalOptions="Center"
               Margin="0,8,0,0" />
    </Grid>

</ContentPage>