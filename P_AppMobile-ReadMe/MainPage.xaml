<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="P_AppMobile_ReadMe.MainPage"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20,15,20,5">
            <VerticalStackLayout Grid.Column="0" Spacing="5">
                <Label Text="Tous les livres" FontSize="22" FontAttributes="Bold" TextColor="Black" />
                <BoxView HeightRequest="1" Color="#D3D3D3" HorizontalOptions="Fill" />
            </VerticalStackLayout>
            <Button Grid.Column="1" 
                    Text="⇅ Date" 
                    Clicked="OnSortClicked" 
                    BackgroundColor="Transparent" 
                    TextColor="#512BD4" 
                    FontSize="14"
                    VerticalOptions="Center" />
        </Grid>

        <!-- Barre de filtres par tags -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" HeightRequest="45" Margin="15,0,15,10">
            <HorizontalStackLayout x:Name="TagsFilterLayout" Spacing="8" VerticalOptions="Center">
                <!-- Rempli dynamiquement en C# -->
            </HorizontalStackLayout>
        </ScrollView>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Books}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="10" BorderColor="#D3D3D3" Padding="10" Margin="15,5" BackgroundColor="White" HasShadow="False">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">

                            <Grid Grid.Column="0" WidthRequest="60" HeightRequest="60">
                                <BoxView Color="#512BD4" CornerRadius="5" />
                                <Image Source="{Binding CoverImagePath}" Aspect="AspectFill" Margin="0" />
                            </Grid>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Title}" FontSize="18" TextColor="Black" FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding DisplayDate}" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding TagsText}" FontSize="11" TextColor="#512BD4" FontAttributes="Italic" MaxLines="1" LineBreakMode="TailTruncation" IsVisible="{Binding HasTags}" Margin="0,2,0,0" />
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBookTapped" />
                                </VerticalStackLayout.GestureRecognizers>
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center" HorizontalOptions="End">
                                <Button Text="🏷️"
                                        FontSize="18"
                                        BackgroundColor="Transparent"
                                        TextColor="#512BD4"
                                        Clicked="OnManageTagsClicked"
                                        CommandParameter="{Binding .}" />
                                <Button Text="🗑"
                                        FontSize="20"
                                        BackgroundColor="Transparent"
                                        TextColor="Red" 
                                        Clicked="OnDeleteBookClicked"
                                        CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="3" Text="Importer un livre" Clicked="OnImportClicked" Margin="20" BackgroundColor="#512BD4" TextColor="White" />

        <!-- Tags Management Overlay Panel -->
        <Border Grid.RowSpan="4" 
                IsVisible="{Binding IsTagsPanelVisible}"
                BackgroundColor="White" 
                StrokeShape="RoundRectangle 20"
                Stroke="#512BD4"
                StrokeThickness="2"
                Margin="10,40"
                Padding="20"
                VerticalOptions="Center"
                HorizontalOptions="Fill">
            
            <Grid RowDefinitions="Auto, *, Auto, Auto" RowSpacing="15">
                <!-- Title -->
                <Label Grid.Row="0" Text="Gérer les tags" FontSize="20" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" />
                
                <!-- Tags List -->
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Tags de ce livre :" FontAttributes="Bold" TextColor="Black" FontSize="14" />
                        <FlexLayout x:Name="BookTagsFlexLayout" Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center" AlignContent="Start">
                            <!-- Populated dynamically in C# -->
                        </FlexLayout>
                        
                        <Label Text="Tous les autres tags existants (cliquer pour associer) :" FontAttributes="Bold" TextColor="Gray" FontSize="13" Margin="0,10,0,0" />
                        <FlexLayout x:Name="AllTagsFlexLayout" Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center" AlignContent="Start">
                            <!-- Populated dynamically in C# -->
                        </FlexLayout>
                    </VerticalStackLayout>
                </ScrollView>
                
                <!-- Add Tag Entry -->
                <Grid Grid.Row="2" ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <Entry Grid.Column="0" x:Name="NewTagEntry" Placeholder="Nouveau tag..." TextColor="Black" PlaceholderColor="Gray" />
                    <Button Grid.Column="1" Text="Ajouter" BackgroundColor="#512BD4" TextColor="White" Clicked="OnAddTagClicked" />
                </Grid>
                
                <!-- Close Button -->
                <Button Grid.Row="3" Text="Fermer" BackgroundColor="Gray" TextColor="White" Clicked="OnCloseTagsPanelClicked" />
            </Grid>
        </Border>
    </Grid>

</ContentPage>