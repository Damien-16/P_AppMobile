<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="P_AppMobile_ReadMe.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:P_AppMobile_ReadMe"
    Shell.FlyoutBehavior="Flyout"
    Title="ReadMe"
    Shell.BackgroundColor="White"
    Shell.TitleColor="Black">

    <Shell.FlyoutHeader>
        <Grid BackgroundColor="#512BD4" HeightRequest="150" Padding="20">
            <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                <Label Text="ReadMe" FontSize="28" FontAttributes="Bold" TextColor="White" />
                <Label Text="Votre bibliothèque de poche" FontSize="14" TextColor="#D3D3D3" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.ToolbarItems>
        <ToolbarItem 
            Text="Rechercher"
            IconImageSource="search.png"
            Order="Primary" />
    </Shell.ToolbarItems>

    <FlyoutItem Title="Accueil" FlyoutIcon="home.png">
        <ShellContent
            Title="Bibliothèque"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="main" />
    </FlyoutItem>

</Shell>