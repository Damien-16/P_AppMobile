<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="P_AppMobile_ReadMe.DetailPage"
             Shell.NavBarIsVisible="False"
             Title="Lecture"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="20">
        
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="40, *, 40" Margin="0,0,0,20" VerticalOptions="Center">
            <!-- Tags button -->
            <Label Grid.Column="0" Text="🏷️" FontSize="26" TextColor="#512BD4" VerticalOptions="Center" HorizontalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTagsButtonClicked" />
                </Label.GestureRecognizers>
            </Label>
            
            <Label Grid.Column="1" Text="{Binding SelectedBook.Title, TargetNullValue='Lecture'}" 
                   FontSize="20" TextColor="Black" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                   
            <!-- Back chevron -->
            <Label Grid.Column="2" Text="✕" FontSize="24" TextColor="Gray" VerticalOptions="Center" HorizontalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- Progress Bar -->
        <ProgressBar Grid.Row="1" Progress="{Binding ProgressValue}" ProgressColor="Black" BackgroundColor="#E0E0E0" Margin="0,0,0,20" HeightRequest="8" />

        <!-- Content -->
        <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="15">
                <!-- Cover Image visible only on first page -->
                <Image 
                    Source="{Binding SelectedBook.CoverImagePath}"
                    IsVisible="{Binding IsCoverVisible}"
                    HeightRequest="300"
                    Aspect="AspectFit"
                    HorizontalOptions="Center" />
                    
                <Label Text="{Binding CurrentPageText}" FontSize="16" TextColor="Black" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Footer / Navigation -->
        <Grid Grid.Row="3" ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="20" Margin="0,20,0,0">
            <Button Grid.Row="0" Grid.Column="0" Text="&#x2190;" FontSize="24" TextColor="Black" BackgroundColor="#D3D3D3" CornerRadius="8" Clicked="OnPreviousClicked" />
            <Button Grid.Row="0" Grid.Column="1" Text="&#x2192;" FontSize="24" TextColor="Black" BackgroundColor="#D3D3D3" CornerRadius="8" Clicked="OnNextClicked" />
            
            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding PageIndicator}" TextColor="Black" HorizontalOptions="Center" Margin="0,10,0,0" FontSize="14" />
        </Grid>

        <!-- Tags Management Overlay Panel -->
        <Border Grid.RowSpan="4" 
                IsVisible="{Binding IsTagsPanelVisible}"
                BackgroundColor="White" 
                StrokeShape="RoundRectangle 20"
                Stroke="#512BD4"
                StrokeThickness="2"
                Margin="10,40"
                Padding="20"
                VerticalOptions="Center"
                HorizontalOptions="Fill">
            
            <Grid RowDefinitions="Auto, *, Auto, Auto" RowSpacing="15">
                <!-- Title -->
                <Label Grid.Row="0" Text="Gérer les tags" FontSize="20" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" />
                
                <!-- Tags List -->
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Tags de ce livre :" FontAttributes="Bold" TextColor="Black" FontSize="14" />
                        <FlexLayout x:Name="BookTagsFlexLayout" Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center" AlignContent="Start">
                            <!-- Populated dynamically in C# -->
                        </FlexLayout>
                        
                        <Label Text="Tous les autres tags existants (cliquer pour associer) :" FontAttributes="Bold" TextColor="Gray" FontSize="13" Margin="0,10,0,0" />
                        <FlexLayout x:Name="AllTagsFlexLayout" Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center" AlignContent="Start">
                            <!-- Populated dynamically in C# -->
                        </FlexLayout>
                    </VerticalStackLayout>
                </ScrollView>
                
                <!-- Add Tag Entry -->
                <Grid Grid.Row="2" ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <Entry Grid.Column="0" x:Name="NewTagEntry" Placeholder="Nouveau tag..." TextColor="Black" PlaceholderColor="Gray" />
                    <Button Grid.Column="1" Text="Ajouter" BackgroundColor="#512BD4" TextColor="White" Clicked="OnAddTagClicked" />
                </Grid>
                
                <!-- Close Button -->
                <Button Grid.Row="3" Text="Fermer" BackgroundColor="Gray" TextColor="White" Clicked="OnCloseTagsPanelClicked" />
            </Grid>
        </Border>
    </Grid>

</ContentPage>